# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings > API in the Supabase dashboard).
#
# Leave .env.local absent/empty for local dev without Supabase — the app
# then falls back to a name-only, localStorage-backed mode automatically.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
